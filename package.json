{
  "name": "reto-rimac",
  "version": "1.0.0",
  "description": "Backend de agendamiento de citas médicas para asegurados (PE/CL) en AWS Serverless",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm test",
    "offline": "serverless offline start",
    "deploy": "npm run verify && serverless deploy --stage dev",
    "remove": "serverless remove --stage dev"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "mysql2": "^3.11.0",
    "ulid": "^2.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "serverless": "3.40.0",
    "serverless-esbuild": "^1.54.0",
    "serverless-iam-roles-per-function": "^3.2.0",
    "serverless-offline": "13.9.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.22.0"
  }
}
